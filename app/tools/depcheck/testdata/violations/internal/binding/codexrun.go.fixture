package binding

import (
	"os/exec"
	"path/filepath"
)

// Codex アダプタ以外から同梱の Codex を起動する違反。
// 起動設定の固定と起動後の検査を通らない経路ができる。
func startCodex(resources string) error {
	cmd := exec.Command(filepath.Join(resources, "codex", "codex"), "app-server")
	return cmd.Run()
}

// 実行ファイル名を字面で持つ形も同じ。
func codexVersion() error {
	return exec.Command("/Applications/Codex.app/Contents/Resources/codex", "--version").Run()
}
